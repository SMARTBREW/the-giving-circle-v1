# Public env vars (safe to expose to the browser)
# FastAPI public API (forms / blog / animal welfare)
# Local: use a free port if Next already occupies 3001 (e.g. http://localhost:3010)
NEXT_PUBLIC_API_URL=http://localhost:3010
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_DEBUG=true

# Feature flags
NEXT_PUBLIC_FEATURE_NEW_DASHBOARD=false
NEXT_PUBLIC_FEATURE_EXPERIMENTAL_API=false
NEXT_PUBLIC_FEATURE_BETA=false
