PORT=3001
NODE_ENV=development
# ENVIRONMENT=production

# Required — Atlas or local Mongo
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGO_URI=  # alias for MONGODB_URI
MONGODB_DB_NAME=thegivingcircle

FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=1

# Email: gmail | aws-ses | ses | sendgrid | custom
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
FROM_EMAIL=
RECEIVER_EMAIL=hello@thegivingcircle.in

# Used when EMAIL_SERVICE=custom
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Used when EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=

# Blog generate
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BLOG_UPDATE_SECRET=

# Optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
